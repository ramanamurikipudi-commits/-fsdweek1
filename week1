const express = require("express");

const app = express();
const PORT = 3000;

// ================================
// MIDDLEWARE
// ================================

// JSON parsing middleware
app.use(express.json());

// Logger middleware
function logger(req, res, next) {
    console.log(
        `[${new Date().toISOString()}] ${req.method} ${req.originalUrl}`
    );
    next();
}

// Request timing middleware
function timer(req, res, next) {
    const start = Date.now();

    res.on("finish", () => {
        const time = Date.now() - start;
        console.log(
            `[${new Date().toISOString()}] ${req.method} ${req.originalUrl} ` +
            `Request completed in ${time} ms`
        );
    });

    next();
}

// Apply middleware globally
app.use(logger);
app.use(timer);


// ================================
// PART A - ROUTING
// ================================

// Basic route
app.get("/", (req, res) => {
    res.send("Welcome to ExpressJS Routing and Middleware Demo");
});

// Route parameter
// Example: /user/42
app.get("/user/:id", (req, res) => {
    const id = req.params.id;

    res.send(`User ID: ${id}`);
});

// Query parameters
// Example: /search?q=express&limit=5
app.get("/search", (req, res) => {
    const q = req.query.q || "";
    const limit = req.query.limit || "not specified";

    res.send(`Searching for '${q}', limit ${limit}`);
});

// Display original URL
app.get("/current-url", (req, res) => {
    res.json({
        message: "Current URL",
        originalUrl: req.originalUrl
    });
});

// Redirect
app.get("/home", (req, res) => {
    res.redirect("/");
});


// ================================
// PART B - BOOKS RESOURCE
// ================================

let books = [
    {
        id: 1,
        title: "The Hobbit",
        author: "Tolkien"
    },
    {
        id: 2,
        title: "Dune",
        author: "Herbert"
    }
];

let nextId = 3;


// GET /books
// Get all books
app.get("/books", (req, res) => {
    res.json(books);
});


// GET /books/:id
// Get a specific book
app.get("/books/:id", (req, res) => {
    const id = parseInt(req.params.id);

    const book = books.find(book => book.id === id);

    if (!book) {
        return res.status(404).json({
            error: "Book not found"
        });
    }

    res.json(book);
});


// POST /books
// Add a new book
app.post("/books", (req, res) => {
    const { title, author } = req.body;

    // Validate input
    if (!title || !author) {
        return res.status(400).json({
            error: "Title and author are required"
        });
    }

    const newBook = {
        id: nextId++,
        title: title,
        author: author
    };

    books.push(newBook);

    res.status(201).json(newBook);
});


// DELETE /books/:id
// Delete a book
app.delete("/books/:id", (req, res) => {
    const id = parseInt(req.params.id);

    const index = books.findIndex(book => book.id === id);

    if (index === -1) {
        return res.status(404).json({
            error: "Book not found"
        });
    }

    books.splice(index, 1);

    res.status(204).send();
});


// ================================
// PART C - ROUTE-SPECIFIC MIDDLEWARE
// ================================

function checkApiKey(req, res, next) {

    if (req.headers["x-api-key"] === "12345") {
        next();
    } else {
        res.status(401).json({
            error: "Unauthorized",
            message: "Valid API key required"
        });
    }
}


// Protected route
app.get("/protected", checkApiKey, (req, res) => {
    res.json({
        message: "You have successfully accessed the protected route"
    });
});


// ================================
// 404 HANDLER
// ================================

app.use((req, res) => {
    res.status(404).json({
        error: "Route Not Found"
    });
});


// ================================
// START SERVER
// ================================

app.listen(PORT, () => {
    console.log(`====================================`);
    console.log(`ExpressJS Server Started`);
    console.log(`Server: http://localhost:${PORT}`);
    console.log(`====================================`);
});
